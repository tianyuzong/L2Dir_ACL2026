# Copy this file to your shell startup script or source it manually after replacing
# every <...> placeholder with your own local values.
#
# Do not commit real private account values or machine-specific paths.

# Repository location. Leave unset if you run scripts from this folder.
# export REPO_ROOT=<path-to-this-l2dir-open-source-folder>

# Required for training: local MMEB-train image directory.
export TRAIN_IMAGE_DIR=<replace-with-your-local-MMEB-train-image-dir>

# Required for evaluation: local MMEB-V2 image-task root.
export EVAL_IMAGE_ROOT=<replace-with-your-local-MMEB-V2-image-task-root>

# Training model. Use a public model id or your own local base model path.
export TRAIN_MODEL_NAME=Qwen/Qwen2-VL-2B-Instruct

# Evaluation model. Replace with your trained checkpoint path or released model id.
export EVAL_MODEL_NAME=<replace-with-your-trained-checkpoint-or-model-id>

# Output locations. Replace with directories writable on your machine.
export OUTPUT_DIR=<replace-with-your-training-output-dir>
export OUTPUT_BASEDIR=<replace-with-your-evaluation-output-dir>

# GPU configuration. The released scripts default to 8 GPUs.
export CUDA_VISIBLE_DEVICES=0,1,2,3,4,5,6,7
export NUM_GPUS=8

# Optional Hugging Face cache and endpoint settings. Replace only if needed.
# export HF_HOME=<replace-with-your-huggingface-cache-dir>
# export HF_DATASETS_CACHE=<replace-with-your-huggingface-datasets-cache-dir>
# export HF_ENDPOINT=<replace-with-your-huggingface-endpoint-or-mirror>

# Optional experiment tracking. Keep real account values outside the repository.
# export REPORT_TO=wandb
# export WANDB_PROJECT=<replace-with-your-wandb-project>
# export WANDB_ENTITY=<replace-with-your-wandb-entity>
